# ==== Movies ====

# api for creating user
###
POST http://127.0.0.1:8000/film/register/
Content-Type: application/json

{
    "username":"user1",
    "email":"user@gmail.com",
    "password":"user@123"
}

#api for genrating token
###
POST http://127.0.0.1:8000/film/login/
Content-Type: application/json

{
    "username":"user1",
    "password":"user@123"
}

#api for creating movies
###
POST http://127.0.0.1:8000/film/add/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
    "title":"Jhonwick",

    "year":2020,

    "ratings":7.9

}

# api for fetching
###
GET http://127.0.0.1:8000/film/add/2/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# api for updating 
###
PUT http://127.0.0.1:8000/film/add/1/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
  "id": 1,
  "title": "Eko",
  "year": 2026,
  "genres": "Action",
  "ratings": "7.7",
  "language": "Malayalam",
  "created_at": "2026-10-26T17:22:09.209753Z",
  "updated_at": "2026-10-26T17:22:09.209873Z"
}

# api for delete
###
DELETE http://127.0.0.1:8000/film/add/1/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# ==== SONGS APP API ====

#api for adding song
###
POST http://127.0.0.1:8000/track/song/2/play/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
    "title":"Karintho",

    "duration":"220",

    "singer":"Christo Xavier"

}

# api for list song
###
GET http://127.0.0.1:8000/track/all/song/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# api for retreive song
###
GET http://127.0.0.1:8000/track/song/3/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# api for update song
###
PUT http://127.0.0.1:8000/track/song/2/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
  "id": 2,
  "title": "Karintho",
  "duration": "210",
  "singer": "Christo Xavier",
  "track_number": 2,
  "created_at": "2026-10-27T14:04:09.452855Z",
  "updated_at": "2026-10-27T14:04:09.452894Z",
  "movie": 2,
  "created_by": 1
}

# api for delete song
###
DELETE http://127.0.0.1:8000/track/song/2/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1




# ==== Reviwly APP API ====

#api for creating review
###
POST http://127.0.0.1:8000/review/movie/3/add/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
    "message":"Good Movie,Repeated Value....What a perfomance",

    "ratings":7.6
}

# api for listing all reviews
###
GET http://127.0.0.1:8000/review/movie/all/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# api for retrieve reviews
###
GET http://127.0.0.1:8000/review/movie/all/2/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

# api for reviews
###
PUT http://127.0.0.1:8000/review/movie/all/2/
Content-Type: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1

{
  "id": 2,
  "message": "Good Movie,Repeated Value....What a perfomance",
  "ratings": "8.1",
  "created_at": "2026-10-27T17:15:01.341730Z",
  "update_at": "2026-10-27T17:15:01.341792Z",
  "movie": 3,
  "created_by": 1
}

# api for delete reviews
###
DELETE http://127.0.0.1:8000/review/movie/all/2/
Accept: application/json
Authorization: Token 68721eb818608f4f82157fd2aba097cbd67827c1


